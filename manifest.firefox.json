{
  "manifest_version": 3,
  "name": "Modal Remover & Scroll Unlocker",
  "version": "0.1.2",
  "author": "azrafe7 (Giuseppe Di Mauro)",
  "description": "Remove full-screen pop-ups and overlays and restore page scrolling with one click. On-demand, private, no tracking.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "azrafe7@gmail.com_modal-unlocker",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "Remove modal & unlock scroll",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}